22px;padding:40px}.export-box .export-icon{width:75px;height:75px;border-radius:24px;background:#e8f1ee;color:var(--teal);display:grid;place-items:center;font-size:28px;margin:auto}.export-box h3{font-size:25px;margin:17px 0 7px}.export-box p{max-width:500px;color:var(--muted);font-size:12px}.admin-modal{position:fixed;inset:0;z-index:1000;display:grid;place-items:center;padding:20px;background:rgba(5,30,29,.6);backdrop-filter:blur(6px)}.admin-modal-card{width:min(620px,100%);max-height:90vh;overflow:auto;background:#fff;border-radius:24px;padding:24px;box-shadow:0 30px 90px rgba(0,0,0,.25)}.admin-modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.admin-modal-head h3{margin:0}.admin-modal-head button{width:38px;height:38px;border-radius:50%;border:1px solid var(--line);background:#fff;font-size:20px;cursor:pointer}.experience-edit-form{display:grid;gap:13px}.media-preview{border-radius:17px;overflow:hidden;background:#f2f3f2;min-height:120px;display:grid;place-items:center}.media-preview img,.media-preview video{max-height:330px;width:100%;object-fit:contain}.mobile-admin-menu{display:none}

@media (max-width:1000px){
  .hero{grid-template-columns:1fr 1fr;gap:25px}.letter-grid{grid-template-columns:repeat(3,1fr)}
  .song-card{grid-template-columns:auto 1fr}.audio-player{grid-column:1/-1}.method-card{gap:35px;padding:42px}.admin-grid{grid-template-columns:1fr}.stat-grid{grid-template-columns:repeat(2,1fr)}.content-studio{grid-template-columns:160px 190px 1fr}.audio-layout{grid-template-columns:1fr}.settings-layout{grid-template-columns:1fr}
}
@media (max-width:760px){
  .shell{width:min(100% - 26px,1180px)}.site-header{height:73px}.header-actions .soft-button{display:none}.brand-mark{width:43px;height:43px;border-radius:14px}.brand span:last-child{display:none}
  .hero{display:block;min-height:auto;padding:35px 0 80px}.hero h1{font-size:clamp(48px,14vw,68px)}.hero-copy>p{font-size:16px}.hero-meta{gap:15px}.hero-meta div{display:block}.hero-meta span{display:block;margin-top:6px}.hero-stage{min-height:500px;margin-top:35px}.book-card{width:min(330px,78vw);padding:34px 28px}.book-letter{font-size:96px;height:125px}.book-card h2{font-size:27px}.progress-card{left:0;bottom:2px}
  .song-section{margin-bottom:85px}.song-card{padding:22px;border-radius:26px;grid-template-columns:auto 1fr;gap:16px}.song-art{width:70px;height:70px;border-radius:20px}.song-copy h2{font-size:21px}.audio-player{padding:12px;grid-column:1/-1}
  .section-heading{display:block;margin-bottom:27px}.section-heading h2{font-size:44px}.section-heading>p{margin-top:17px}.explorer-toolbar{grid-template-columns:1fr auto;top:8px}.toolbar-status{display:none}.reset-button{padding:0 13px}.letter-grid{grid-template-columns:repeat(2,1fr);gap:12px}.letter-card,.loading-card{min-height:235px}.card-letter{font-size:76px}.word-option{min-height:68px}.word-option .arabic{font-size:24px}
  .method-card{display:block;padding:30px 23px;border-radius:28px}.method-intro h2{font-size:42px}.method-steps{margin-top:28px}.quote-strip{grid-template-columns:1fr;overflow:auto;grid-auto-flow:column;grid-auto-columns:85%;scroll-snap-type:x mandatory}.quote-strip article{scroll-snap-align:start}.footer-inner{display:block;text-align:center}.footer-brand{justify-content:center}.footer-inner>p{margin:24px auto}.footer-inner>a{display:inline-block}
  .word-modal{padding:0;place-items:end center}.word-dialog{width:100%;max-height:94vh;border-radius:26px 26px 0 0}.dialog-hero{min-height:155px;padding:22px 58px 21px 20px;grid-template-columns:auto 1fr;gap:15px}.dialog-letter{width:76px;height:76px;border-radius:22px;font-size:50px}.dialog-title-wrap h2{font-size:39px}.mark-button{grid-column:1/-1;width:max-content;min-height:39px}.modal-close{right:11px;top:11px;width:41px;height:41px}.dialog-scroll{padding:18px 16px 26px}.content-grid.two-col,.heart-grid,.share-layout{grid-template-columns:1fr}.experience-grid{grid-template-columns:1fr}.panel-heading{align-items:flex-start;flex-direction:column}.purpose-banner p{font-size:16px}.story-card p{font-size:17px}.share-intro{padding:21px}
  .admin-login{display:block}.login-art{min-height:330px;padding:34px 25px}.login-art h1{font-size:49px}.login-quote{display:none}.login-panel{padding:22px 15px;margin-top:-42px;position:relative}.login-card{padding:25px;border-radius:24px}.admin-app{display:block}.admin-sidebar{position:fixed;z-index:60;left:0;top:0;bottom:0;width:250px;transform:translateX(-105%);transition:.25s}.admin-sidebar.is-open{transform:translateX(0)}.mobile-admin-menu{display:grid;width:41px;height:41px;place-items:center;border:1px solid var(--line);border-radius:12px;background:#fff;margin-right:10px}.admin-topbar{padding:12px 14px}.admin-topbar>div:first-of-type{display:flex;align-items:center}.admin-top-actions .soft-button{display:none}.admin-content{padding:18px 13px}.stat-grid{grid-template-columns:1fr 1fr;gap:10px}.stat-card{padding:15px}.stat-card strong{font-size:27px}.content-studio{display:block}.studio-column{border-right:0;border-bottom:1px solid var(--line);max-height:180px}.letter-list,.word-list{display:flex;overflow:auto}.studio-list button{min-width:90px}.studio-form-wrap{padding:16px}.form-grid{grid-template-columns:1fr}.audio-layout,.settings-layout{grid-template-columns:1fr}.admin-heading{display:block}.admin-heading .primary-button{margin-top:14px}.admin-table-wrap{border-radius:16px}
}
@media (max-width:420px){.letter-grid{grid-template-columns:1fr 1fr}.letter-card,.loading-card{min-height:215px}.card-front,.card-back{padding:14px}.card-letter{font-size:68px}.word-option{padding:8px}.word-option .arabic{font-size:21px}.hero-actions{display:grid}.hero-actions>*{width:100%}.hero-meta{justify-content:space-between}.stat-grid{grid-template-columns:1fr}}
@media (prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}

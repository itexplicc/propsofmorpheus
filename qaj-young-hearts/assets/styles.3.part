e:13px}.experience-card p{font-size:13px;color:var(--muted);margin:7px 0 0;white-space:pre-wrap}.experience-card small{display:block;color:#91a09e;margin-top:10px}.experience-loading,.experience-empty{grid-column:1/-1;padding:42px;text-align:center;border:1px dashed var(--line);border-radius:18px;color:var(--muted)}
.share-layout{display:grid;grid-template-columns:.78fr 1.22fr;gap:30px}.share-intro{padding:26px;border-radius:23px;background:linear-gradient(145deg,#f2ead6,#fbf7ed)}.share-intro h3{font-size:31px;line-height:1.05;margin:14px 0 14px;letter-spacing:-.04em}.share-intro>p{font-size:14px;color:var(--muted)}.privacy-note{display:flex;gap:10px;align-items:flex-start;margin-top:25px;padding-top:18px;border-top:1px solid rgba(16,47,45,.1)}.privacy-note>span{width:24px;height:24px;flex:0 0 auto;border-radius:50%;display:grid;place-items:center;background:var(--teal);color:#fff;font-size:11px}.privacy-note p{font-size:11px;color:var(--muted);margin:2px 0 0}
.share-form{display:grid;gap:14px}.share-form label{display:grid;gap:7px;font-size:12px;font-weight:800}.share-form input[type=text],.share-form textarea{width:100%;border:1px solid var(--line);border-radius:15px;background:#fff;padding:13px 14px;outline:0;resize:vertical}.file-drop{min-height:112px;border:1.5px dashed rgba(11,91,88,.25);border-radius:17px;background:#f7fbfa;padding:18px;place-items:center;text-align:center;cursor:pointer}.file-drop input{position:absolute;opacity:0;pointer-events:none}.file-drop .drop-icon{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;background:var(--teal);color:#fff;font-size:18px}.file-drop strong{font-size:12px}.file-drop small{color:var(--muted);font-weight:500}.submit-experience{min-height:50px}.submit-experience:disabled{opacity:.6;cursor:wait}.form-status{min-height:20px;font-size:12px;color:var(--muted);margin:0}.form-status.success{color:#267151}.form-status.error{color:#a64040}
.toast-region{position:fixed;z-index:2000;right:20px;bottom:20px;display:grid;gap:10px}.toast{max-width:340px;padding:14px 17px;border-radius:15px;background:#092f2e;color:#fff;box-shadow:0 20px 50px rgba(0,0,0,.2);font-size:13px;animation:toastIn .25s both}.toast.error{background:#7f3030}@keyframes toastIn{from{opacity:0;transform:translateY(8px)}}

/* Admin */
.admin-page{background:#eef2ef;min-height:100vh}.admin-shell{min-height:100vh}.admin-login{min-height:100vh;display:grid;grid-template-columns:1fr 1fr}.login-art{padding:55px;background:linear-gradient(145deg,#0f716c,#063d3a);color:#fff;display:flex;flex-direction:column;justify-content:space-between;position:relative;overflow:hidden}.login-art:before{content:"";position:absolute;width:620px;height:620px;border-radius:50%;border:1px solid rgba(255,255,255,.1);left:-260px;bottom:-290px;box-shadow:0 0 0 70px rgba(255,255,255,.03),0 0 0 140px rgba(255,255,255,.02)}.login-art-copy{position:relative;max-width:560px}.login-art h1{font-size:clamp(50px,5vw,76px);line-height:.95;letter-spacing:-.055em;margin:25px 0}.login-art h1 em{font-family:var(--font-ar);color:#e5ca84;font-style:normal}.login-art p{color:rgba(255,255,255,.67);font-size:17px;max-width:480px}.login-quote{position:relative;padding:20px 23px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.06);border-radius:20px;max-width:480px;backdrop-filter:blur(10px)}.login-quote strong{display:block;font-size:14px}.login-quote small{color:rgba(255,255,255,.56)}
.login-panel{display:grid;place-items:center;padding:40px}.login-card{width:min(430px,100%);background:#fff;border-radius:28px;padding:34px;box-shadow:0 25px 70px rgba(35,70,65,.12)}.login-card h2{font-size:29px;margin:25px 0 6px;letter-spacing:-.04em}.login-card>p{color:var(--muted);font-size:13px;margin:0 0 25px}.auth-tabs{display:flex;gap:5px;padding:5px;background:#f1f4f2;border-radius:14px;margin-bottom:20px}.auth-tabs button{flex:1;min-height:40px;border:0;border-radius:10px;background:transparent;font-size:12px;font-weight:800;cursor:pointer}.auth-tabs button.is-active{background:#fff;box-shadow:0 4px 12px rgba(31,67,64,.08)}.auth-form{display:grid;gap:14px}.auth-form label{display:grid;gap:7px;font-size:12px;font-weight:800}.auth-form input{min-height:48px;border:1px solid var(--line);border-radius:14px;padding:0 13px}.auth-form .primary-button{min-height:50px;margin-top:5px}.auth-message{font-size:12px;min-height:20px;color:var(--muted);margin:4px 0 0}.login-footnote{font-size:10px!important;margin:18px 0 0!important;text-align:center}
.admin-app{min-height:100vh;display:grid;grid-template-columns:250px 1fr}.admin-sidebar{background:#092f2e;color:#fff;padding:22px 16px;display:flex;flex-direction:column;position:sticky;top:0;height:100vh}.admin-brand{padding:5px 8px 22px;border-bottom:1px solid rgba(255,255,255,.08);margin-bottom:18px}.admin-brand small{color:rgba(255,255,255,.48)}.admin-nav{display:grid;gap:5px}.admin-nav button{min-height:45px;border:0;border-radius:13px;background:transparent;color:rgba(255,255,255,.62);display:flex;align-items:center;gap:11px;padding:0 13px;text-align:left;font-size:12px;font-weight:700;cursor:pointer}.admin-nav button svg{width:19px;fill:none;stroke:currentColor;stroke-width:1.8}.admin-nav button.is-active{background:rgba(255,255,255,.1);color:#fff}.admin-user{margin-top:auto;padding:13px;border-top:1px solid rgba(255,255,255,.08)}.admin-user strong,.admin-user small{display:block;overflow:hidden;text-overflow:ellipsis}.admin-user strong{font-size:12px}.admin-user small{font-size:10px;color:rgba(255,255,255,.48)}.admin-user button{margin-top:12px;width:100%;min-height:38px;border-radius:11px;border:1px solid rgba(255,255,255,.12);background:transparent;color:#fff;font-size:11px;cursor:pointer}
.admin-main{min-width:0}.admin-topbar{min-height:78px;padding:15px 28px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(20,65,62,.08);background:rgba(255,255,255,.78);backdrop-filter:blur(16px);position:sticky;top:0;z-index:30}.admin-topbar h1{font-size:20px;margin:0}.admin-topbar p{font-size:11px;color:var(--muted);margin:2px 0 0}.admin-top-actions{display:flex;gap:9px}.admin-top-actions a{min-height:40px;font-size:11px}.admin-content{padding:28px}.admin-view{display:none}.admin-view.is-active{display:block}.admin-heading{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:22px}.admin-heading h2{font-size:31px;letter-spacing:-.04em;margin:0}.admin-heading p{color:var(--muted);font-size:13px;margin:5px 0 0}.stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.stat-card{background:#fff;border:1px solid var(--line);border-radius:20px;padding:20px;box-shadow:0 8px 24px rgba(31,67,64,.04)}.stat-card small{display:block;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.1em;font-weight:800}.stat-card strong{display:block;font-size:32px;margin-top:9px}.stat-card span{font-size:11px;color:#6c817d}.admin-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:16px;margin-top:16px}.admin-card{background:#fff;border:1px solid var(--line);border-radius:21px;padding:21px;box-shadow:0 8px 24px rgba(31,67,64,.04)}.admin-card-head{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:17px}.admin-card h3{font-size:15px;margin:0}.admin-card-head small{color:var(--muted)}.activity-list{display:grid;gap:9px}.activity-row{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:11px;padding:11px;border-radius:13px;background:#f5f7f5}.activity-row .dot{width:9px;height:9px;border-radius:50%;background:var(--gold)}.activity-row strong,.activity-row small{display:block}.activity-row strong{font-size:11px}.activity-row small{font-size:9px;color:var(--muted)}.activity-row time{font-size:9px;color:var(--muted)}
.content-studio{display:grid;grid-template-columns:210px 220px 1fr;min-height:660px;background:#fff;border:1px solid var(--line);border-radius:22px;overflow:hidden}.studio-column{border-right:1px solid var(--line);padding:16px;overflow:auto}.studio-column h3{font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);margin:2px 0 13px}.studio-list{display:grid;gap:5px}.studio-list button{min-height:43px;border:0;border-radius:11px;background:transparent;text-align:left;padding:8px 10px;cursor:pointer}.studio-list button:hover{background:#f4f6f4}.studio-list button.is-active{background:#eaf2ef;color:var(--teal);font-weight:800}.letter-list button{display:flex;align-items:center;gap:10px}.letter-list .list-arabic{font:700 24px/1 var(--font-ar)}.word-list button strong{font:700 19px/1.1 var(--font-ar);display:block}.word-list button small{color:var(--muted);font-size:9px}.studio-form-wrap{padding:22px;overflow:auto}.editor-form{display:grid;gap:14px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}.editor-form label,.settings-form label,.audio-form label{display:grid;gap:6px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}.editor-form input,.editor-form textarea,.editor-form select,.settings-form input,.settings-form textarea,.audio-form input,.audio-form select,.experience-edit-form input,.experience-edit-form textarea{width:100%;border:1px solid var(--line);border-radius:12px;padding:10px 11px;background:#fff;color:var(--ink);text-transform:none;letter-spacing:normal;font-size:12px}.editor-form textarea{resize:vertical}.editor-form .arabic-input{font:700 24px/1.3 var(--font-ar);direction:rtl;text-align:right}.form-actions{display:flex;justify-content:flex-end;gap:9px;padding-top:8px}.form-actions button{min-height:42px;font-size:11px}.admin-table-wrap{background:#fff;border:1px solid var(--line);border-radius:21px;overflow:auto}.admin-table{width:100%;border-collapse:collapse;min-width:760px}.admin-table th,.admin-table td{padding:13px 15px;border-bottom:1px solid var(--line);text-align:left;font-size:11px;vertical-align:middle}.admin-table th{font-size:9px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);background:#f7f8f7}.admin-table tr:last-child td{border-bottom:0}.status-pill{display:inline-flex;min-height:26px;align-items:center;padding:0 9px;border-radius:999px;font-size:9px;font-weight:800;text-transform:uppercase}.status-pill.pending{background:#fff3d7;color:#8a6219}.status-pill.approved{background:#e5f5ed;color:#267151}.status-pill.rejected{background:#f9e4e4;color:#9c4545}.row-actions{display:flex;gap:5px}.row-actions button{min-height:32px;border:1px solid var(--line);border-radius:9px;background:#fff;padding:0 9px;font-size:9px;font-weight:800;cursor:pointer}.row-actions button.primary{background:var(--teal);color:#fff;border-color:var(--teal)}.row-actions button.danger{color:#a83c3c}.audio-layout{display:grid;grid-template-columns:340px 1fr;gap:16px}.audio-form,.settings-form{background:#fff;border:1px solid var(--line);border-radius:21px;padding:21px;display:grid;gap:13px;height:max-content}.audio-list{display:grid;gap:10px}.audio-row{background:#fff;border:1px solid var(--line);border-radius:17px;padding:14px;display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center}.audio-thumb{width:48px;height:48px;border-radius:14px;background:linear-gradient(145deg,#0d6a66,#073d3b);color:#fff;display:grid;place-items:center}.audio-row strong,.audio-row small{display:block}.audio-row strong{font-size:12px}.audio-row small{font-size:9px;color:var(--muted)}.audio-row audio{width:100%;height:32px;margin-top:6px}.settings-layout{display:grid;grid-template-columns:1fr 1fr;gap:16px}.danger-zone{border-color:rgba(166,57,57,.2);background:#fffafa}.danger-zone h3{color:#9c4545}.export-box{min-height:300px;display:grid;place-items:center;text-align:center;background:#fff;border:1px solid var(--line);border-radius:
d input::placeholder{color:#91a09e}
.toolbar-status{padding:0 12px;color:var(--muted);font-size:12px;font-weight:700}.reset-button{min-height:42px;box-shadow:none;background:var(--paper-2)}
.letter-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:17px;perspective:1400px}
.letter-card{min-height:264px;border-radius:27px;position:relative;transform-style:preserve-3d;transition:transform .55s cubic-bezier(.2,.8,.2,1),filter .2s;cursor:pointer;isolation:isolate}
.letter-card:hover{transform:translateY(-5px)}
.letter-card.is-open{transform:rotateY(180deg)}
.letter-card.is-open:hover{transform:rotateY(180deg) translateY(-3px)}
.card-face{position:absolute;inset:0;border-radius:27px;backface-visibility:hidden;-webkit-backface-visibility:hidden;overflow:hidden;border:1px solid rgba(22,57,55,.08);box-shadow:0 16px 38px rgba(31,67,64,.09);display:flex;flex-direction:column}
.card-front{background:linear-gradient(145deg,var(--card-a),var(--card-b));padding:18px}
.card-front:before{content:"";position:absolute;inset:11px;border:1px solid rgba(255,255,255,.55);border-radius:20px}
.card-front:after{content:"";position:absolute;width:170px;height:170px;border-radius:50%;right:-65px;top:-55px;background:rgba(255,255,255,.2);box-shadow:0 0 0 28px rgba(255,255,255,.07)}
.card-number{position:relative;z-index:1;font-size:11px;font-weight:800;color:var(--card-accent);opacity:.75;letter-spacing:.12em}
.card-letter{position:relative;z-index:1;flex:1;display:grid;place-items:center;font:700 92px/1 var(--font-ar);color:var(--card-accent);text-shadow:0 2px rgba(255,255,255,.5);padding-bottom:8px}
.card-footer{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;color:var(--card-accent)}.card-footer span{font-size:11px;font-weight:700}.card-footer i{width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,.48);display:grid;place-items:center;font-style:normal;font-size:17px}
.card-back{transform:rotateY(180deg);background:var(--white);padding:18px}
.back-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.mini-letter{width:48px;height:48px;display:grid;place-items:center;border-radius:16px;background:linear-gradient(145deg,var(--card-a),var(--card-b));font:700 29px/1 var(--font-ar);color:var(--card-accent)}.back-top span{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);font-weight:800}
.word-options{display:grid;gap:10px}.word-option{min-height:75px;border:1px solid var(--line);border-radius:17px;background:#fff;padding:10px 12px;display:grid;grid-template-columns:1fr auto;align-items:center;text-align:left;cursor:pointer;transition:.2s}.word-option:hover{background:var(--paper);border-color:rgba(12,91,88,.25);transform:translateX(-2px)}.word-option .arabic{display:block;font:700 28px/1.25 var(--font-ar);color:var(--ink)}.word-option .english{display:block;font-size:11px;color:var(--muted);margin-top:2px}.word-option .arrow{width:31px;height:31px;border-radius:50%;display:grid;place-items:center;background:var(--paper-2);color:var(--teal)}
.letter-card.search-match{filter:none}.letter-card.search-hidden{display:none}.word-option.search-hidden{display:none}.word-option.search-match{border-color:rgba(199,154,59,.55);box-shadow:0 0 0 3px rgba(199,154,59,.08)}
.loading-card{height:264px;border-radius:27px;background:linear-gradient(90deg,#eee8db 25%,#f8f5ed 38%,#eee8db 62%);background-size:400% 100%;animation:shimmer 1.5s infinite}@keyframes shimmer{to{background-position:-100% 0}}
.empty-state{text-align:center;padding:60px 20px}.empty-state span{width:80px;height:80px;display:grid;place-items:center;margin:auto;border-radius:28px;background:#fff;box-shadow:var(--shadow-soft);font:700 45px/1 var(--font-ar);color:var(--gold)}.empty-state h3{font-size:24px;margin:18px 0 6px}.empty-state p{color:var(--muted);margin:0}

.method-section{padding-bottom:125px}.method-card{border-radius:36px;background:linear-gradient(145deg,#0d6965,#063d3a);color:#fff;padding:54px;display:grid;grid-template-columns:1fr 1.15fr;gap:70px;align-items:center;box-shadow:0 32px 75px rgba(7,61,59,.22);position:relative;overflow:hidden}.method-card:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 14% 20%,rgba(237,211,151,.2),transparent 30%),radial-gradient(circle at 90% 95%,rgba(126,202,193,.18),transparent 34%)}.method-intro,.method-steps{position:relative}.method-intro h2{font-size:clamp(38px,4.2vw,58px);margin:16px 0 22px}.method-intro p{color:rgba(255,255,255,.66);max-width:470px}.method-steps{list-style:none;margin:0;padding:0;display:grid;gap:12px}.method-steps li{display:grid;grid-template-columns:auto 1fr;align-items:center;gap:18px;padding:18px;border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.06);border-radius:21px;backdrop-filter:blur(10px)}.method-steps>li>span{width:48px;height:48px;display:grid;place-items:center;border-radius:15px;background:rgba(235,210,149,.15);color:#ecd18c;font-weight:800;font-size:12px}.method-steps strong,.method-steps small{display:block}.method-steps strong{font-size:16px}.method-steps small{color:rgba(255,255,255,.57);font-size:12px;margin-top:3px}

.community-preview{padding-bottom:130px}.quote-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}.quote-strip article{padding:27px;border-radius:24px;background:rgba(255,255,255,.78);border:1px solid var(--line);box-shadow:var(--shadow-soft)}.quote-strip article>span{font:700 52px/1 Georgia,serif;color:var(--gold)}.quote-strip p{font-size:15px;margin:-8px 0 24px;color:var(--ink-2)}.quote-strip small{color:var(--muted);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em}
.site-footer{background:#092f2e;color:#fff;padding:58px 0}.footer-inner{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:50px}.footer-brand small{color:rgba(255,255,255,.55)}.footer-inner>p{color:rgba(255,255,255,.58);font-size:13px;max-width:500px;margin:0}.footer-inner>a{color:#e4c984;text-decoration:none;font-weight:700;font-size:13px}

/* Word dialog */
body.modal-open{overflow:hidden}.word-modal{position:fixed;inset:0;z-index:1000;display:grid;place-items:center;padding:28px}.modal-backdrop{position:absolute;inset:0;background:rgba(5,30,29,.68);backdrop-filter:blur(8px);animation:fadeIn .22s both}.word-dialog{position:relative;width:min(1060px,100%);max-height:min(900px,92vh);background:var(--white);border-radius:32px;box-shadow:0 35px 110px rgba(0,0,0,.28);overflow:hidden;display:flex;flex-direction:column;animation:dialogIn .32s cubic-bezier(.2,.8,.2,1) both}
@keyframes fadeIn{from{opacity:0}}@keyframes dialogIn{from{opacity:0;transform:translateY(18px) scale(.98)}}
.modal-close{position:absolute;right:18px;top:18px;z-index:5;width:46px;height:46px;border-radius:50%;border:1px solid rgba(255,255,255,.25);background:rgba(7,61,59,.18);color:#fff;font-size:27px;cursor:pointer;backdrop-filter:blur(10px)}
.dialog-hero{min-height:184px;padding:28px 82px 27px 34px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:24px;color:var(--dialog-accent,#345);background:linear-gradient(135deg,var(--dialog-a,#dfe5ff),var(--dialog-b,#cdd6ff));position:relative;overflow:hidden}.dialog-hero:before{content:"";position:absolute;width:300px;height:300px;border-radius:50%;right:-100px;top:-155px;background:rgba(255,255,255,.25);box-shadow:0 0 0 38px rgba(255,255,255,.08)}.dialog-letter{position:relative;width:104px;height:104px;border-radius:30px;display:grid;place-items:center;background:rgba(255,255,255,.55);border:1px solid rgba(255,255,255,.78);font:700 65px/1 var(--font-ar);box-shadow:0 18px 35px rgba(26,60,57,.1)}.dialog-title-wrap{position:relative}.dialog-kicker{display:block;font-size:10px;text-transform:uppercase;letter-spacing:.15em;font-weight:800;opacity:.64}.dialog-title-wrap h2{font:700 50px/1.1 var(--font-ar);margin:2px 0 0}.dialog-title-wrap p{margin:0;font-weight:700;opacity:.75}.mark-button{position:relative;min-height:48px;border-radius:999px;padding:0 17px;border:1px solid rgba(255,255,255,.7);background:rgba(255,255,255,.5);font-size:12px;font-weight:800;cursor:pointer;display:flex;align-items:center;gap:8px}.mark-button span:first-child{font-size:20px}.mark-button.is-marked{background:var(--teal);color:#fff;border-color:var(--teal)}
.dialog-nav{display:flex;gap:4px;padding:10px 13px;border-bottom:1px solid var(--line);overflow:auto;scrollbar-width:none;background:#fff}.dialog-nav::-webkit-scrollbar{display:none}.dialog-tab{min-height:43px;padding:0 15px;border:0;border-radius:13px;background:transparent;color:var(--muted);font-size:12px;font-weight:800;white-space:nowrap;cursor:pointer}.dialog-tab.is-active{background:var(--paper-2);color:var(--teal)}
.dialog-scroll{overflow:auto;padding:24px 28px 32px;overscroll-behavior:contain}.dialog-panel{animation:panelIn .22s ease both}@keyframes panelIn{from{opacity:0;transform:translateY(5px)}}
.purpose-banner{display:flex;gap:16px;align-items:flex-start;padding:21px 23px;border-radius:20px;background:linear-gradient(135deg,rgba(11,91,88,.08),rgba(199,154,59,.08));border:1px solid rgba(11,91,88,.11);margin-bottom:16px}.purpose-banner>span{width:42px;height:42px;flex:0 0 auto;display:grid;place-items:center;border-radius:14px;background:var(--teal);color:#fff}.purpose-banner small{font-size:10px;color:var(--teal);font-weight:800;text-transform:uppercase;letter-spacing:.12em}.purpose-banner p{margin:3px 0 0;font-size:18px;font-weight:600;color:var(--ink)}
.content-grid{display:grid;gap:16px}.content-grid.two-col{grid-template-columns:1fr 1fr}.content-card{display:flex;gap:15px;padding:22px;border:1px solid var(--line);border-radius:20px;background:#fff}.content-card.full{margin-top:16px}.card-icon{width:42px;height:42px;flex:0 0 auto;border-radius:14px;background:var(--paper-2);display:grid;place-items:center;color:var(--teal);font-weight:800}.content-card h3{font-size:15px;margin:1px 0 9px}.content-card p{margin:0;color:var(--muted);font-size:13px}.content-card ul,.content-card ol{margin:0;padding-left:19px;color:var(--muted);font-size:13px}.content-card li+li{margin-top:7px}.materials{background:#fffaf0}.steps{background:#f7fbfa}.steps .card-icon{font-size:10px}
.story-card{padding:30px;border-radius:23px;background:linear-gradient(135deg,#0b5b58,#073d3b);color:#fff;position:relative;overflow:hidden}.story-card:after{content:"❝";position:absolute;right:20px;top:-8px;font:700 100px/1 Georgia;color:rgba(255,255,255,.08)}.story-label{font-size:10px;color:#e2cb8c;text-transform:uppercase;letter-spacing:.13em;font-weight:800}.story-card p{font-size:20px;line-height:1.55;max-width:820px;margin:13px 0 0;position:relative}.heart-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:16px;margin-top:16px}.ayah-card,.dua-card{padding:24px;border-radius:21px;border:1px solid var(--line);background:#fff}.ayah-card>span,.dua-card>span{font:700 28px/1 var(--font-ar);color:var(--gold)}.ayah-card h3,.dua-card h3{font-size:13px;margin:12px 0 8px}.ayah-card blockquote{margin:0;font-size:15px;color:var(--ink-2);font-style:italic}.dua-card{background:#fff8e9}.dua-card p{color:var(--ink-2);font-size:15px;margin:0}
.panel-heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:19px}.panel-heading h3{font-size:25px;margin:7px 0 0;letter-spacing:-.03em}.experience-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.experience-card{padding:18px;border:1px solid var(--line);border-radius:19px;background:#fff}.experience-card-media{aspect-ratio:16/10;border-radius:14px;overflow:hidden;background:var(--paper-2);margin-bottom:14px}.experience-card-media img,.experience-card-media video{width:100%;height:100%;object-fit:cover}.experience-card strong{font-siz

/* QAJ Young Hearts V2.3 — refined internal word experience */
@media (min-width:641px){
  .word-modal{padding:22px!important;place-items:center!important}
  .modal-backdrop{
    background:
      radial-gradient(circle at 18% 15%,rgba(210,177,103,.16),transparent 28%),
      radial-gradient(circle at 82% 82%,rgba(62,139,132,.18),transparent 30%),
      rgba(5,30,29,.72)!important;
    backdrop-filter:blur(12px) saturate(.9)!important;
  }
  .word-dialog{
    width:min(960px,calc(100vw - 44px))!important;
    max-height:min(790px,91vh)!important;
    border-radius:28px!important;
    border:1px solid rgba(255,255,255,.54)!important;
    background:#fbf8f0!important;
    box-shadow:0 34px 100px rgba(3,30,28,.38),0 2px 0 rgba(255,255,255,.6) inset!important;
  }
  .dialog-hero{
    min-height:138px!important;
    padding:23px 74px 23px 26px!important;
    grid-template-columns:82px minmax(0,1fr) auto!important;
    gap:20px!important;
    align-items:center!important;
  }
  .dialog-letter{width:82px!important;height:82px!important;border-radius:23px!important;font-size:52px!important}
  .dialog-title-wrap{
    min-width:0;
    display:grid!important;
    grid-template-columns:max-content 1fr!important;
    grid-template-areas:"kicker kicker" "word meaning"!important;
    align-items:end!important;
    column-gap:15px!important;
    row-gap:4px!important;
  }
  .dialog-kicker{grid-area:kicker!important;font-size:9px!important;letter-spacing:.18em!important;opacity:.72!important}
  .dialog-title-wrap h2{
    grid-area:word!important;
    width:max-content!important;
    max-width:100%!important;
    margin:0!important;
    font-size:clamp(38px,5vw,52px)!important;
    line-height:1!important;
    text-align:left!important;
    justify-self:start!important;
  }
  .dialog-title-wrap p{
    grid-area:meaning!important;
    width:max-content!important;
    max-width:100%!important;
    margin:0 0 5px!important;
    padding:6px 11px!important;
    border-radius:999px!important;
    background:rgba(255,255,255,.48)!important;
    border:1px solid rgba(255,255,255,.64)!important;
    font-size:12px!important;
    line-height:1!important;
    font-weight:800!important;
    opacity:.86!important;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
  }
  .mark-button{min-height:42px!important;padding:0 15px!important;border-radius:14px!important;font-size:11px!important}
  .dialog-nav{
    display:grid!important;
    grid-template-columns:repeat(5,minmax(0,1fr))!important;
    gap:6px!important;
    padding:8px 14px!important;
    overflow:visible!important;
  }
  .dialog-tab{min-height:40px!important;padding:0 9px!important;border-radius:11px!important;font-size:11px!important}
  .dialog-scroll{padding:20px 22px 25px!important}
}

.modal-close{
  border:1px solid rgba(16,47,45,.10)!important;
  background:rgba(255,255,255,.88)!important;
  color:var(--ink)!important;
  box-shadow:0 10px 28px rgba(35,65,62,.12)!important;
  backdrop-filter:blur(14px)!important;
  transition:transform .2s,background .2s!important;
}
.modal-close:hover{transform:rotate(5deg) scale(1.04);background:#fff!important}
.dialog-hero{color:var(--dialog-accent,#345)!important;overflow:hidden!important}
.dialog-hero:before{
  width:240px!important;
  height:240px!important;
  right:-76px!important;
  top:-132px!important;
  background:rgba(255,255,255,.2)!important;
  box-shadow:0 0 0 28px rgba(255,255,255,.065),0 0 0 56px rgba(255,255,255,.035)!important;
}
.dialog-hero:after{
  content:"";
  position:absolute;
  left:124px;
  right:74px;
  bottom:0;
  height:1px;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.78),transparent);
}
.dialog-letter{
  background:rgba(255,255,255,.58)!important;
  border:1px solid rgba(255,255,255,.78)!important;
  box-shadow:0 14px 30px rgba(31,65,61,.11),0 1px 0 rgba(255,255,255,.8) inset!important;
}
.mark-button{
  border:1px solid rgba(255,255,255,.72)!important;
  background:rgba(255,255,255,.48)!important;
  box-shadow:0 10px 24px rgba(44,71,68,.07)!important;
}
.mark-button:hover{background:rgba(255,255,255,.76)!important;transform:translateY(-1px)}
.mark-button.is-marked{background:var(--teal)!important;border-color:var(--teal)!important}
.dialog-nav{
  background:rgba(255,253,249,.96)!important;
  border-bottom:1px solid rgba(20,65,62,.09)!important;
  box-shadow:0 8px 22px rgba(20,65,62,.035)!important;
  position:relative!important;
  z-index:4!important;
}
.dialog-tab{
  color:#5f7471!important;
  letter-spacing:-.01em!important;
  transition:background .2s,color .2s,transform .2s!important;
}
.dialog-tab:hover{background:#f2eee4!important;color:var(--ink)!important}
.dialog-tab.is-active{
  background:linear-gradient(135deg,var(--teal),var(--teal-deep))!important;
  color:#fff!important;
  box-shadow:0 9px 20px rgba(7,61,59,.17)!important;
}
.dialog-scroll{
  background:
    radial-gradient(circle at 4% 6%,rgba(199,154,59,.065),transparent 25%),
    linear-gradient(180deg,#fbfaf6,#f7f1e7)!important;
  scrollbar-width:thin;
  scrollbar-color:rgba(11,91,88,.34) transparent;
}
.dialog-scroll::-webkit-scrollbar{width:8px}
.dialog-scroll::-webkit-scrollbar-track{background:transparent}
.dialog-scroll::-webkit-scrollbar-thumb{background:rgba(11,91,88,.28);border-radius:999px;border:2px solid transparent;background-clip:padding-box}
.dialog-panel{max-width:900px;margin-inline:auto}

.purpose-banner{
  padding:17px 19px!important;
  border-radius:17px!important;
  margin-bottom:12px!important;
  background:linear-gradient(135deg,rgba(11,91,88,.095),rgba(199,154,59,.09))!important;
  border-color:rgba(11,91,88,.10)!important;
  box-shadow:0 10px 24px rgba(32,69,66,.035)!important;
}
.purpose-banner>span{width:36px!important;height:36px!important;border-radius:12px!important;font-size:13px!important}
.purpose-banner small{font-size:9px!important}
.purpose-banner p{font-size:16px!important;line-height:1.38!important}
.content-grid{gap:12px!important}
.content-card{
  gap:12px!important;
  padding:17px!important;
  border-radius:17px!important;
  border-color:rgba(20,65,62,.10)!important;
  background:rgba(255,255,255,.82)!important;
  box-shadow:0 10px 25px rgba(31,67,64,.035)!important;
  position:relative;
  overflow:hidden;
}
.content-card:before{
  content:"";
  position:absolute;
  left:0;
  top:14px;
  bottom:14px;
  width:3px;
  border-radius:0 999px 999px 0;
  background:linear-gradient(var(--teal-2),var(--gold));
  opacity:.5;
}
.content-card.full{margin-top:12px!important}
.card-icon{width:36px!important;height:36px!important;border-radius:11px!important;font-size:12px!important}
.content-card h3{font-size:13px!important;margin:0 0 7px!important}
.content-card p,.content-card ul,.content-card ol{font-size:12px!important;line-height:1.55!important}
.content-card li+li{margin-top:5px!important}
.materials{background:linear-gradient(145deg,#fffaf0,#fff)!important}
.steps{background:linear-gradient(145deg,#f5fbf9,#fff)!important}

.story-card{
  min-height:126px!important;
  padding:24px 30px!important;
  border-radius:20px!important;
  background:
    radial-gradient(circle at 92% 15%,rgba(233,204,134,.13),transparent 23%),
    linear-gradient(135deg,#0b615c,#073f3c)!important;
  border:1px solid rgba(255,255,255,.10)!important;
  box-shadow:0 18px 38px rgba(7,61,59,.14)!important;
}
.story-card:before{
  content:"";
  position:absolute;
  left:0;
  top:0;
  bottom:0;
  width:5px;
  background:linear-gradient(#edd493,#b98631);
}
.story-card:after{font-size:78px!important;right:24px!important;top:-2px!important;color:rgba(255,255,255,.07)!important}
.story-label{font-size:9px!important;letter-spacing:.16em!important}
.story-card p{font-size:18px!important;line-height:1.48!important;margin-top:10px!important;max-width:760px!important}
.heart-grid{grid-template-columns:1.15fr .85fr!important;gap:12px!important;margin-top:12px!important}
.ayah-card,.dua-card{
  min-height:155px;
  padding:20px!important;
  border-radius:18px!important;
  box-shadow:0 10px 25px rgba(31,67,64,.035)!important;
  position:relative;
  overflow:hidden;
}
.ayah-card{background:rgba(255,255,255,.86)!important}
.dua-card{background:linear-gradient(145deg,#fff8e8,#fffdf8)!important}
.ayah-card>span,.dua-card>span{
  display:inline-flex!important;
  align-items:center!important;
  min-height:31px!important;
  padding:0 10px!important;
  border-radius:10px!important;
  background:rgba(199,154,59,.10)!important;
  font-size:20px!important;
}
.ayah-card h3,.dua-card h3{font-size:12px!important;margin:11px 0 7px!important}
.ayah-card blockquote,.dua-card p{font-size:14px!important;line-height:1.55!important}
.panel-heading{margin-bottom:14px!important}.panel-heading h3{font-size:22px!important}
.experience-card{padding:14px!important;border-radius:16px!important;box-shadow:0 9px 22px rgba(31,67,64,.035)!important}
.share-intro{padding:22px!important;border-radius:18px!important}.share-intro h3{font-size:26px!important}
.share-form input[type=text],.share-form textarea{background:rgba(255,255,255,.9)!important}
.file-drop{min-height:98px!important}

@media (max-width:640px){
  .dialog-hero{background:linear-gradient(135deg,var(--dialog-a,#dfe5ff),var(--dialog-b,#cdd6ff))!important}
  .dialog-title-wrap h2{text-align:right!important;color:currentColor!important}
  .dialog-title-wrap p{
    display:inline-flex!important;
    width:max-content!important;
    max-width:100%!important;
    padding:4px 8px!important;
    border-radius:999px!important;
    background:rgba(255,255,255,.48)!important;
    border:1px solid rgba(255,255,255,.62)!important;
    font-size:10px!important;
    font-weight:800!important;
  }
  .dialog-nav{background:#fffdf9!important}
  .dialog-tab.is-active{background:linear-gradient(135deg,var(--teal),var(--teal-deep))!important;color:#fff!important}
  .dialog-scroll{background:linear-gradient(180deg,#fbfaf6,#f7f1e7)!important}
  .story-card{padding:20px 20px 20px 24px!important}
  .story-card p{font-size:16px!important}
  .heart-grid{grid-template-columns:1fr!important}
  .ayah-card,.dua-card{min-height:auto!important}
}

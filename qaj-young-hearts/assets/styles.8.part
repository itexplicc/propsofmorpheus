
/* QAJ Young Hearts V2.5 — official cover, scalable word lists, book illustrations */

/* Present the supplied artwork as a real book rather than a pasted rectangle. */
.book-halo{
  width:540px!important;
  height:540px!important;
  background:
    radial-gradient(circle at 45% 42%,rgba(255,221,166,.88),rgba(239,181,192,.45) 48%,rgba(165,216,207,.16) 67%,transparent 73%)!important;
  filter:blur(5px)!important;
}
.book-card{
  width:min(390px,80vw)!important;
  aspect-ratio:1476/2047!important;
  padding:0!important;
  border-radius:18px 27px 27px 18px!important;
  background:#efc2bb url('qaj-book-cover.webp') center/100% 100% no-repeat!important;
  overflow:hidden!important;
  border:1px solid rgba(92,62,55,.18)!important;
  box-shadow:
    -13px 16px 0 #ead7b4,
    -17px 21px 0 rgba(125,88,55,.17),
    0 42px 86px rgba(72,53,48,.28),
    inset 0 0 0 1px rgba(255,255,255,.34)!important;
  transform:rotate(2.4deg)!important;
  animation:bookCoverFloat 6s ease-in-out infinite!important;
}
@keyframes bookCoverFloat{
  50%{transform:rotate(.8deg) translateY(-9px)}
}
.book-card>*{display:none!important}
.book-card:before{
  content:""!important;
  position:absolute!important;
  inset:0!important;
  border:0!important;
  border-radius:inherit!important;
  background:
    linear-gradient(102deg,rgba(255,255,255,.24),transparent 19%,transparent 76%,rgba(255,255,255,.10)),
    linear-gradient(180deg,rgba(255,255,255,.10),transparent 18%,transparent 78%,rgba(86,45,38,.08))!important;
  pointer-events:none!important;
  z-index:2!important;
}
.book-card:after{
  content:""!important;
  position:absolute!important;
  left:0!important;
  top:0!important;
  bottom:0!important;
  width:12px!important;
  background:linear-gradient(90deg,rgba(71,40,36,.28),rgba(255,255,255,.15),transparent)!important;
  box-shadow:4px 0 8px rgba(72,40,35,.08)!important;
  pointer-events:none!important;
}
.progress-card{bottom:15px!important;left:-7px!important}

/* A letter can grow beyond two words without breaking the compact card. */
.card-back{overflow:hidden!important}
.word-options{
  min-height:0!important;
  max-height:calc(var(--qaj-card-height) - 68px)!important;
  overflow-y:auto!important;
  padding-right:3px!important;
  scrollbar-width:thin;
  scrollbar-color:rgba(11,91,88,.28) transparent;
}
.word-options::-webkit-scrollbar{width:5px}
.word-options::-webkit-scrollbar-thumb{background:rgba(11,91,88,.25);border-radius:99px}
.word-option.has-book-image{
  grid-template-columns:42px minmax(0,1fr) auto!important;
  column-gap:9px!important;
}
.word-option-thumb{
  width:42px;
  height:42px;
  border-radius:11px;
  overflow:hidden;
  background:linear-gradient(145deg,var(--card-a,#f3ead6),var(--card-b,#fff));
  border:1px solid rgba(20,65,62,.10);
  box-shadow:0 5px 13px rgba(31,67,64,.08);
  display:grid;
  place-items:center;
}
.word-option-thumb img{width:100%;height:100%;object-fit:cover;display:block}
.word-option.has-book-image>span:nth-child(2){min-width:0}
.word-option.has-book-image .arabic,
.word-option.has-book-image .english{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* Word-image manager inside the studio. */
.qaj-word-image-manager{
  display:grid;
  grid-template-columns:132px minmax(0,1fr);
  gap:15px;
  padding:15px;
  border:1px solid var(--line);
  border-radius:16px;
  background:linear-gradient(145deg,#fffaf0,#f7fbf9);
}
.qaj-word-image-preview{
  width:132px;
  aspect-ratio:1;
  border-radius:15px;
  overflow:hidden;
  display:grid;
  place-items:center;
  text-align:center;
  background:#fff;
  border:1px dashed rgba(11,91,88,.24);
  color:var(--muted);
  font-size:10px;
}
.qaj-word-image-preview img{width:100%;height:100%;object-fit:cover;display:block}
.qaj-word-image-fields{display:grid;gap:9px;align-content:start}
.qaj-word-image-fields h4{margin:0;color:var(--ink);font-size:13px;text-transform:none;letter-spacing:normal}
.qaj-word-image-fields p{margin:0;color:var(--muted);font-size:10px;line-height:1.45;text-transform:none;letter-spacing:normal}
.qaj-word-image-fields input[type=file],
.qaj-word-image-fields input[type=text]{width:100%;border:1px solid var(--line);border-radius:11px;background:#fff;padding:9px 10px;font-size:11px;text-transform:none;letter-spacing:normal}
.qaj-word-image-actions{display:flex;flex-wrap:wrap;gap:7px}
.qaj-word-image-actions button{min-height:36px;border-radius:10px;font-size:10px}
.qaj-add-word-button{min-height:42px!important;font-size:11px!important}

.qaj-word-modal{
  position:fixed;
  inset:0;
  z-index:1400;
  display:grid;
  place-items:center;
  padding:20px;
  background:rgba(5,30,29,.66);
  backdrop-filter:blur(8px);
}
.qaj-word-modal[hidden]{display:none!important}
.qaj-word-modal-card{
  width:min(570px,100%);
  max-height:90vh;
  overflow:auto;
  border-radius:24px;
  padding:24px;
  background:#fffdf9;
  box-shadow:0 32px 90px rgba(0,0,0,.26);
}
.qaj-word-modal-head{display:flex;align-items:flex-start;justify-content:space-between;gap:15px;margin-bottom:18px}
.qaj-word-modal-head h3{margin:0;font-size:24px;letter-spacing:-.035em}
.qaj-word-modal-head p{margin:4px 0 0;color:var(--muted);font-size:11px}
.qaj-word-modal-head button{width:38px;height:38px;border-radius:50%;border:1px solid var(--line);background:#fff;font-size:20px;cursor:pointer}
.qaj-new-word-form{display:grid;gap:13px}
.qaj-new-word-form label{display:grid;gap:6px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}
.qaj-new-word-form input,.qaj-new-word-form textarea{width:100%;border:1px solid var(--line);border-radius:12px;padding:10px 11px;background:#fff;color:var(--ink);font-size:12px;text-transform:none;letter-spacing:normal}
.qaj-new-word-form .qaj-arabic-input{font:700 26px/1.35 var(--font-ar);direction:rtl;text-align:right}
.qaj-word-draft-note{padding:11px 13px;border-radius:12px;background:#fff4d9;color:#77551a;font-size:10px;line-height:1.45}
.qaj-word-form-status{min-height:18px;margin:0;color:var(--muted);font-size:11px}
.qaj-word-form-status.error{color:#a13f3f}
.qaj-word-form-status.success{color:#267151}

@media (max-width:760px){
  .book-card{width:min(325px,76vw)!important}
  .book-halo{width:440px!important;height:440px!important}
  .progress-card{left:0!important;bottom:-2px!important}
  .word-option.has-book-image{grid-template-columns:35px minmax(0,1fr)!important}
  .word-option.has-book-image .arrow{display:none!important}
  .word-option-thumb{width:35px;height:35px;border-radius:9px}
  .qaj-word-image-manager{grid-template-columns:1fr}
  .qaj-word-image-preview{width:100%;max-width:180px;justify-self:center}
  .qaj-word-modal{padding:10px;place-items:end center}
  .qaj-word-modal-card{width:100%;max-height:93vh;border-radius:23px 23px 10px 10px;padding:20px}
}
